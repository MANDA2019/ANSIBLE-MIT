;
; Reverse zone file for {{ dns_network }}.0/24
;
$TTL    604800
@       IN      SOA     dns1.{{ dns_domain }}. admin.{{ dns_domain }}. (
                              2         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
; Name servers
@       IN      NS      dns1.{{ dns_domain }}.

; PTR records
{% for record in dns_records %}
{{ record.ip.split('.')[-1] }}    IN      PTR     {{ record.name }}.{{ dns_domain }}.
{% endfor %}
