from flask import Flask, render_template, request, jsonify, redirect, url_for
import subprocess
import json
import os
from datetime import datetime
import yaml

app = Flask(__name__)
app.config['SECRET_KEY'] = 'votre-cle-secrete-ici'

# Chemin du projet Ansible
ANSIBLE_DIR = '/home/maharavo/L2/projet_ansible'
PLAYBOOK_DIR = os.path.join(ANSIBLE_DIR, 'playbooks')
INVENTORY_FILE = os.path.join(ANSIBLE_DIR, 'hosts')

# Historique des exécutions
HISTORY_FILE = os.path.join(ANSIBLE_DIR, 'webapp', 'history.json')

def load_history():
    """Charger l'historique des exécutions"""
    if os.path.exists(HISTORY_FILE):
        with open(HISTORY_FILE, 'r') as f:
            return json.load(f)
    return []

def save_history(entry):
    """Sauvegarder une entrée dans l'historique"""
    history = load_history()
    history.insert(0, entry)  # Ajouter au début
    history = history[:50]  # Garder seulement les 50 dernières
    with open(HISTORY_FILE, 'w') as f:
        json.dump(history, f, indent=2)

def get_hosts():
    """Récupérer la liste des hôtes depuis l'inventaire"""
    try:
        result = subprocess.run(
            ['ansible', 'all', '--list-hosts', '-i', INVENTORY_FILE],
            capture_output=True,
            text=True,
            cwd=ANSIBLE_DIR
        )
        hosts = [line.strip() for line in result.stdout.split('\n') if line.strip() and 'hosts' not in line]
        return hosts
    except Exception as e:
        return []

def run_ansible_command(playbook, hosts='all', tags=None):
    """Exécuter une commande Ansible"""
    cmd = ['ansible-playbook', playbook, '-i', INVENTORY_FILE]
    
    if hosts != 'all':
        cmd.extend(['--limit', hosts])
    
    if tags:
        cmd.extend(['--tags', tags])
    
    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            cwd=ANSIBLE_DIR
        )
        
        # Sauvegarder dans l'historique
        entry = {
            'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'playbook': playbook,
            'hosts': hosts,
            'tags': tags,
            'returncode': result.returncode,
            'stdout': result.stdout,
            'stderr': result.stderr
        }
        save_history(entry)
        
        return {
            'success': result.returncode == 0,
            'output': result.stdout,
            'error': result.stderr
        }
    except Exception as e:
        return {
            'success': False,
            'output': '',
            'error': str(e)
        }

@app.route('/')
def index():
    """Page d'accueil - Dashboard"""
    hosts = get_hosts()
    history = load_history()[:5]  # 5 dernières exécutions
    return render_template('index.html', hosts=hosts, history=history)

@app.route('/hosts')
def hosts_page():
    """Page de gestion des hôtes"""
    hosts = get_hosts()
    return render_template('hosts.html', hosts=hosts)

@app.route('/execute')
def execute_page():
    """Page d'exécution des playbooks"""
    hosts = get_hosts()
    return render_template('execute.html', hosts=hosts)

@app.route('/history')
def history_page():
    """Page d'historique"""
    history = load_history()
    return render_template('history.html', history=history)

@app.route('/api/execute', methods=['POST'])
def api_execute():
    """API pour exécuter un playbook"""
    data = request.json
    action = data.get('action')
    hosts = data.get('hosts', 'all')
    
    # Mapping des actions vers les playbooks
    playbook_map = {
        'update': ('site.yml', 'update'),
        'cleanup': ('site.yml', 'cleanup'),
        'network': ('playbooks/network.yml', None),
        'mariadb': ('playbooks/database.yml', None),
        'dns': ('playbooks/dns.yml', None),
        'ssh': ('playbooks/ssh.yml', None),
        'tls': ('playbooks/tls.yml', None),
        'full': ('site.yml', None),
        'system': ('playbooks/system.yml', None),
    }
    
    if action not in playbook_map:
        return jsonify({'success': False, 'error': 'Action inconnue'})
    
    playbook, tags = playbook_map[action]
    result = run_ansible_command(playbook, hosts, tags)
    
    return jsonify(result)

@app.route('/api/ping', methods=['POST'])
def api_ping():
    """API pour tester la connexion aux hôtes"""
    data = request.json
    hosts = data.get('hosts', 'all')
    
    try:
        result = subprocess.run(
            ['ansible', hosts, '-m', 'ping', '-i', INVENTORY_FILE],
            capture_output=True,
            text=True,
            cwd=ANSIBLE_DIR
        )
        
        return jsonify({
            'success': result.returncode == 0,
            'output': result.stdout,
            'error': result.stderr
        })
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)})

@app.route('/api/stats')
def api_stats():
    """API pour obtenir des statistiques"""
    history = load_history()
    
    total = len(history)
    success = sum(1 for h in history if h['returncode'] == 0)
    failed = total - success
    
    # Actions par type
    actions = {}
    for h in history:
        playbook = os.path.basename(h['playbook'])
        actions[playbook] = actions.get(playbook, 0) + 1
    
    return jsonify({
        'total': total,
        'success': success,
        'failed': failed,
        'actions': actions,
        'last_execution': history[0]['timestamp'] if history else None
    })

@app.route('/api/host/<hostname>')
def api_host_info(hostname):
    """API pour obtenir des infos sur un hôte"""
    try:
        # Récupérer les facts de l'hôte
        result = subprocess.run(
            ['ansible', hostname, '-m', 'setup', '-i', INVENTORY_FILE],
            capture_output=True,
            text=True,
            cwd=ANSIBLE_DIR
        )
        
        return jsonify({
            'success': result.returncode == 0,
            'output': result.stdout,
            'error': result.stderr
        })
    except Exception as e:
        return jsonify({'success': False, 'error': str(e)})

if __name__ == '__main__':
    # Créer le fichier d'historique s'il n'existe pas
    if not os.path.exists(HISTORY_FILE):
        with open(HISTORY_FILE, 'w') as f:
            json.dump([], f)
    
    app.run(debug=True, host='0.0.0.0', port=5000)


